#!/bin/sh
set -eu
case "$0" in
  */*) JEV_SCRIPT_DIR=${0%/*} ;;
  *) printf '%s\n' 'PLUGIN_LAUNCH_PATH_REQUIRED' >&2; exit 2 ;;
esac
JEV_PLUGIN_ROOT=$(CDPATH= cd -- "$JEV_SCRIPT_DIR/.." && pwd -P) || exit 3
export PYTHONDONTWRITEBYTECODE=1
[ -f "$JEV_PLUGIN_ROOT/scripts/find-python.sh" ] || { printf '%s\n' 'PLUGIN_FILE_MISSING' >&2; exit 3; }
. "$JEV_PLUGIN_ROOT/scripts/find-python.sh"
jev_find_python || exit 3
if [ "$#" -eq 1 ] && [ "$1" = '--help' ]; then
  exec "$JEV_PYTHON" -I -S -B -c 'import runpy,sys; sys.path.insert(0,sys.argv[1]); sys.argv=["src.adl.api.setup_server",*sys.argv[2:]]; runpy.run_module("src.adl.api.setup_server",run_name="__main__")' "$JEV_PLUGIN_ROOT/runtime" --help
fi
if [ "$#" -ne 1 ]; then
  printf '%s\n' 'WORKSPACE_PATH_REQUIRED' >&2
  exit 2
fi
exec "$JEV_PYTHON" -I -S -B -c 'import runpy,sys; sys.path.insert(0,sys.argv[1]); sys.argv=["src.adl.api.setup_server",*sys.argv[2:]]; runpy.run_module("src.adl.api.setup_server",run_name="__main__")' "$JEV_PLUGIN_ROOT/runtime" --workspace "$1"
