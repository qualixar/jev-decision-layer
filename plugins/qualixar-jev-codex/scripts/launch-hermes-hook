#!/bin/sh
set -eu
case "$0" in
  */*) JEV_SCRIPT_DIR=${0%/*} ;;
  *) exit 3 ;;
esac
JEV_PLUGIN_ROOT=$(CDPATH= cd -- "$JEV_SCRIPT_DIR/.." && pwd -P) || exit 3
[ -f "$JEV_PLUGIN_ROOT/scripts/find-python.sh" ] || exit 3
. "$JEV_PLUGIN_ROOT/scripts/find-python.sh"
jev_find_python || exit 3
exec "$JEV_PYTHON" -I -S -B -c 'import runpy,sys; sys.path.insert(0,sys.argv[1]); runpy.run_module("jev_auto.hermes_hook",run_name="__main__")' "$JEV_PLUGIN_ROOT/runtime"
