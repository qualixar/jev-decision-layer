#!/bin/sh
# Claude Code hook launcher.
#
# A bare `python3` in hooks.json is not safe here: the Claude Code desktop
# app is GUI-launched and inherits a minimal PATH, so `python3` may not
# resolve at all. find-python.sh probes for a 3.11+ interpreter the same way
# for every launcher.
#
# Never blocks. Every failure exits 3 WITHOUT writing to stdout, so Claude
# Code sees a non-blocking hook error and the user's prompt or tool call
# proceeds untouched. Exit 2 is never used: it would block the prompt.
set -eu
case "$0" in
  */*) JEV_SCRIPT_DIR=${0%/*} ;;
  *) exit 3 ;;
esac
JEV_PLUGIN_ROOT=$(CDPATH= cd -- "$JEV_SCRIPT_DIR/.." && pwd -P) || exit 3
export PYTHONDONTWRITEBYTECODE=1
[ -f "$JEV_PLUGIN_ROOT/scripts/find-python.sh" ] || exit 3
. "$JEV_PLUGIN_ROOT/scripts/find-python.sh"
jev_find_python || exit 3
exec "$JEV_PYTHON" -I -S -B -c 'import runpy,sys; sys.path.insert(0,sys.argv[1]); runpy.run_module("jev_auto.claude_hook",run_name="__main__")' "$JEV_PLUGIN_ROOT/runtime"
