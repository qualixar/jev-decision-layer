#!/bin/sh
# Pass-through CLI for the decision layer. Mirrors launch-jev's interpreter
# discovery, but forwards its arguments instead of forcing `mcp`, so the
# documented commands (`jev selftest`, `jev vscode --workspace .`) run from
# any directory without PYTHONPATH.
set -eu
case "$0" in
  */*) JEV_SCRIPT_DIR=${0%/*} ;;
  *) printf '%s\n' 'PLUGIN_LAUNCH_PATH_REQUIRED' >&2; exit 2 ;;
esac
JEV_PLUGIN_ROOT=$(CDPATH= cd -- "$JEV_SCRIPT_DIR/.." && pwd -P) || exit 3
export PYTHONDONTWRITEBYTECODE=1
[ -f "$JEV_PLUGIN_ROOT/scripts/find-python.sh" ] || { printf '%s\n' 'PLUGIN_FILE_MISSING' >&2; exit 3; }
. "$JEV_PLUGIN_ROOT/scripts/find-python.sh"
jev_find_python || exit 3
exec "$JEV_PYTHON" -I -S -B -c 'import runpy,sys; root=sys.argv[1]; sys.path.insert(0,root); sys.argv=[root+"/auto_entry.py",*sys.argv[2:]]; runpy.run_path(root+"/auto_entry.py",run_name="__main__")' "$JEV_PLUGIN_ROOT/runtime" "$@"
