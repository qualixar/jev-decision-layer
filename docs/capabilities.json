      "outcome": "advisory closed-candidate selection"
    },
    {
      "id": "recipes",
      "tool": "jev_recipe_try",
      "outcome": "experimental typed recipe answer with local advisory gate and separate policy receipt"
    },
    {
      "id": "review",
      "tool": "jev_review_diff",
      "outcome": "advisory review focus"
    },
    {
      "id": "context",
      "tool": "jev_reduce",
      "outcome": "extractive view with exact recall"
    },
    {
      "id": "setup",
      "tool": "jev_setup",
      "outcome": "private workspace review wizard"
    },
    {
      "id": "selftest",
      "tool": "jev_recipe_selftest",
      "outcome": "offline replay of shipped synthetic fixtures through the local gate"
    },
    {
      "id": "workbench",
      "tool": "jev workbench",
      "outcome": "local recipe browser with offline examples and reviewed live advisory requests"
    },
    {
      "id": "verify",
      "tool": "jev_verify",
      "outcome": "per-field probability that an extracted field is wrong, with a trustworthy flag"
    },
    {
      "id": "rerank",
      "tool": "jev_rerank",
      "outcome": "absolute passage scores and whether the set answers the question at all"
    }
  ],
