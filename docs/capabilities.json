    "legacy_contracts": 20,
    "additional_specifications": 55,
    "unique_recipes": 55,
    "legacy_contracts_represented_in_recipes": 20,
    "counting_note": "The 20 legacy workflow contracts map into 20 of the 55 recipe specifications; these counts are not additive."
  },
  "decision_modes": [
    {
      "id": "jev-public",
